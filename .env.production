# === Production Environment ===

# Общие
APP_NAME=Copilot for Business
ENVIRONMENT=production

# Backend
BACKEND_PORT=8000
SECRET_KEY=your-very-long-and-secure-production-key-change-this-immediately

# Database (SQLite)
DATABASE_PATH=/app/data/users.db
SQLITE_WAL=1  # Write-Ahead Logging для лучшей производительности
SQLITE_TIMEOUT=30

# Frontend
VITE_API_URL=/api

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
CORS_ORIGINS=https://Business-Copilot.ru

# Performance
WORKERS=4
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100