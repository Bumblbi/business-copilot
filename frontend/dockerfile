# frontend/Dockerfile
FROM node:18-alpine AS builder

WORKDIR /app

# Копируем файлы зависимостей
COPY package.json yarn.lock ./

# Устанавливаем зависимости
RUN yarn install --frozen-lockfile --production=false

# Копируем исходный код
COPY . .

# Даем права на выполнение бинарных файлов в node_modules
RUN chmod -R +x node_modules/.bin/

# Альтернативный вариант - сборка через yarn
RUN yarn build

# Или с использованием npx (после chmod должен работать)
# RUN npx vite build

FROM nginx:alpine

# Копируем собранное приложение
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем конфигурацию nginx (опционально, но рекомендуется)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]